{
  "compilerOptions": 
  {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",

    "jsx": "react-jsx",

    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },

    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["vite/client"]
  },

  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
